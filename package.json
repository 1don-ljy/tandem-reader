{
  "name": "tandem-reader",
  "version": "0.5.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "技术文档双语翻译浏览器扩展",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run typecheck && node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node --test tests/browser/run.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:browser"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
